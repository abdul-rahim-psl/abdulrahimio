---
import type { Stat } from '../data/projects';

interface Props {
  stat: Stat;
}

const { stat } = Astro.props;
---

{stat.from && (
  <>
    <span class="from">{stat.from}</span>{' '}
    <span class="arrow" aria-hidden="true">→</span>
    <span class="sr-only">to</span>{' '}
  </>
)}
{stat.value}

<style>
  .from {
    color: var(--muted);
  }

  .arrow {
    font-weight: 400;
    color: var(--accent);
  }

  /* Screen readers hear "4 to any" rather than "4 right arrow any". */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
