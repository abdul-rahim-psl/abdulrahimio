---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../site';

const nav = [
  { href: '/#work', label: 'Work', section: '/projects' },
  { href: '/videos', label: 'Videos', section: '/videos' },
  { href: '/writing', label: 'Writing', section: '/writing' },
];
const path = Astro.url.pathname;
---

<header class="wrap">
  <a class="wordmark" href="/">
    {site.name}
    <span class="pulse" aria-hidden="true"></span>
  </a>
  <nav aria-label="Main">
    {nav.map(({ href, label, section }) => (
      <a href={href} aria-current={path.startsWith(section) ? 'page' : undefined}>
        {label}
      </a>
    ))}
    <a class="hi" href={`mailto:${site.email}`}>Say hi</a>
  </nav>
  <ThemeToggle />
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
    padding-block: 1.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  /* A live "on air" dot: the one bit of motion that never stops. */
  .pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 0.45rem transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }

  nav {
    --pad: 0.7rem;
    display: flex;
    gap: 0.25rem;
  }

  nav a {
    padding: 0.4rem var(--pad);
    border-radius: 999px;
    font-size: 0.95rem;
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--accent-soft);
  }

  nav .hi {
    color: var(--accent-ink);
    font-weight: 600;
  }

  /* Phones can't fit the name, four links and the toggle in one row, so the links get a row of their own. */
  @media (max-width: 560px) {
    nav {
      order: 1;
      width: 100%;
      /* Lines up the first link's text, not its pill, with the name above. */
      margin-left: calc(-1 * var(--pad));
    }
  }

  @media (max-width: 480px) {
    nav {
      --pad: 0.45rem;
    }

    nav a {
      font-size: 0.9rem;
    }
  }
</style>
