---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { getPosts } from '../lib/feeds';
import { formatDate } from '../lib/format';

const posts = await getPosts();
---

<Base title="Writing" description="Long-form write-ups by Abdul Rahim on the systems he builds and the problems inside them.">
  <header class="page-head">
    <p class="eyebrow">Medium</p>
    <h1>Notes from <span class="voice">the work</span>.</h1>
    <p class="lede">Long-form write-ups on the systems I build and the problems inside them.</p>
  </header>

  {posts.length > 0 ? (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a href={post.url} target="_blank" rel="noopener">
            {post.cover && <img src={post.cover} alt="" loading="lazy" />}
            <span class="date">{formatDate(post.published)}</span>
            <span class="title">{post.title}</span>
            <span class="excerpt">{post.excerpt}</span>
            <span class="read">Read on Medium ↗</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="lede">The latest posts couldn't be loaded right now.</p>
  )}

  <a class="more" href={site.links.medium} target="_blank" rel="noopener">Follow on Medium ↗</a>
</Base>

<style>
  .page-head {
    display: grid;
    gap: 1.1rem;
    padding: 3.5rem 0 2.5rem;
  }

  h1 {
    font-size: clamp(2.4rem, 5.5vw, 3.8rem);
    font-weight: 750;
    letter-spacing: -0.045em;
  }

  h1 .voice {
    font-size: 1.12em;
  }

  .posts {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts a {
    display: grid;
    gap: 0.6rem;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .posts a:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
  }

  .posts img {
    width: 100%;
    max-height: 18rem;
    margin-bottom: 0.4rem;
    border-radius: 10px;
    object-fit: cover;
  }

  .date {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .title {
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .excerpt {
    color: var(--muted);
  }

  .read {
    margin-top: 0.4rem;
    font-weight: 600;
    color: var(--accent-ink);
  }

  .more {
    display: inline-block;
    margin-top: 3rem;
    padding: 0.8rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 600;
    color: var(--accent-ink);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .more:hover {
    border-color: var(--accent);
  }
</style>
