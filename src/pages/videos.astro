---
import Base from '../layouts/Base.astro';
import { site } from '../site';
import { getChannel } from '../lib/feeds';
import { formatDate } from '../lib/format';

const channel = await getChannel();
---

<Base title="Videos" description="Abdul Rahim thinks out loud on YouTube: LeetCode from first principles, design lessons, and deep dives into real systems.">
  <header class="page-head">
    <p class="eyebrow">YouTube · {channel.title}</p>
    <h1>I think <span class="voice">out loud</span>.</h1>
    <p class="lede">LeetCode from first principles, design lessons, and deep dives into the real systems I work on.</p>
  </header>

  {channel.videos.length > 0 ? (
    <ul class="grid">
      {channel.videos.map((video) => (
        <li>
          <a href={video.url} target="_blank" rel="noopener">
            <img src={video.thumbnail} alt="" width="480" height="360" loading="lazy" />
            <span class="title">{video.title}</span>
            <span class="date">{formatDate(video.published)}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="lede">The latest videos couldn't be loaded right now.</p>
  )}

  <a class="more" href={site.links.youtube} target="_blank" rel="noopener">
    {channel.videoCount ? `All ${channel.videoCount} videos on YouTube` : 'All videos on YouTube'} ↗
  </a>
</Base>

<style>
  .page-head {
    display: grid;
    gap: 1.1rem;
    padding: 3.5rem 0 2.5rem;
  }

  h1 {
    font-size: clamp(2.4rem, 5.5vw, 3.8rem);
    font-weight: 750;
    letter-spacing: -0.045em;
  }

  h1 .voice {
    font-size: 1.12em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 2rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid a {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: inherit;
    text-decoration: none;
  }

  /* YouTube thumbnails are 4:3 with letterbox bars; a hair under 16:9 crops the bars away fully. */
  .grid img {
    width: 100%;
    aspect-ratio: 16 / 8.85;
    border: 1px solid var(--line);
    border-radius: 12px;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-weight: 650;
    line-height: 1.35;
    transition: color 0.2s;
  }

  .date {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .grid a:hover img {
    transform: scale(1.02);
  }

  .grid a:hover .title {
    color: var(--accent-ink);
  }

  .more {
    display: inline-block;
    margin-top: 3rem;
    padding: 0.8rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 600;
    color: var(--accent-ink);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .more:hover {
    border-color: var(--accent);
  }
</style>
